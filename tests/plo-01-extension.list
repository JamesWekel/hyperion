                                                   862 *----------------------------------------------------------------------
                                                   863 * PTTABLE: generate table of pointers to individual tests
                                                   864 *----------------------------------------------------------------------
                                                   865
                                                   866          MACRO
                                                   867          PTTABLE
                                                   868          GBLA  &TNUM
                                                   869          LCLA  &CUR
                                                   870 &CUR     SETA  1
                                                   871 .*
                                                   872 TTABLE   DS    0F
                                                   873 .LOOP    ANOP
                                                   874 .*
                                                   875          DC    A(T&CUR)
                                                   876 .*
                                                   877 &CUR     SETA  &CUR+1
                                                   878          AIF   (&CUR LE &TNUM).LOOP
                                                   879 *
                                                   880          DC    A(0)                END OF TABLE
                                                   881          DC    A(0)
                                                   882 .*
                                                   883          MEND
