                                                   419 ***********************************************************************
                                                   420 *        Issue HERCULES MESSAGE
                                                   421 *              R0 = length of message
                                                   422 *              R1 = message address
                                                   423 *              R2 = return address
                                                   424 ***********************************************************************

000006F0  4900 85E0                     000007E0   426 MSG      CH    R0,=H'0'            Do we even HAVE a message?
000006F4  07D2                                     427          BNHR  R2                  No, ignore

000006F6  9002 852C                     0000072C   429          STM   R0,R2,MSGSAVE       Save registers

000006FA  4900 85E2                     000007E2   431          CH    R0,=AL2(L'MSGMSG)   Message length within limits?
000006FE  47D0 8506                     00000706   432          BNH   MSGOK               Yes, continue
00000702  4100 005F                     0000005F   433          LA    R0,L'MSGMSG         No, set to maximum

00000706  1820                                     435 MSGOK    LR    R2,R0               Copy length to work register
00000708  0620                                     436          BCTR  R2,0                Minus-1 for execute
0000070A  4420 8538                     00000738   437          EX    R2,MSGMVC           Copy message to O/P buffer

0000070E  4120 200A                     0000000A   439          LA    R2,1+L'MSGCMD(,R2)  Calculate true command length
00000712  4110 853E                     0000073E   440          LA    R1,MSGCMD           Point to true command

00000716  83120008                                 442          DC    X'83',X'12',X'0008' Issue Hercules Diagnose X'008'
0000071A  4780 8526                     00000726   443          BZ    MSGRET              Return if successful
                                                   444
0000071E  1222                                     445          LTR   R2,R2               Is Diag8 Ry (R2) 0?
00000720  4780 8526                     00000726   446          BZ    MSGRET                an error occurred but coninue
                                                   447
00000724  0000                                     448          DC    H'0'                CRASH for debugging purposes

00000726  9802 852C                     0000072C   450 MSGRET   LM    R0,R2,MSGSAVE       Restore registers
0000072A  07F2                                     451          BR    R2                  Return to caller






0000072C  00000000 00000000                        453 MSGSAVE  DC    3F'0'               Registers save area
                                                   454
00000738  D200 8547 1000      00000747  00000000   455 MSGMVC   MVC   MSGMSG(0),0(R1)     Executed instruction


0000073E  D4E2C7D5 D6C8405C                        457 MSGCMD   DC    C'MSGNOH * '        *** HERCULES MESSAGE COMMAND ***
00000747  40404040 40404040                        458 MSGMSG   DC    CL95' '             The message text to be displayed
