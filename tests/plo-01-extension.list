                                                   204 ***********************************************************************
                                                   205 *    Do tests in the PLOETST table
                                                   206 ***********************************************************************
                                                   207
000020D0  58C0 8680                     00002680   208          L     R12,=A(PLOTESTS)    get table of test address
                                                   209
                              000020D4  00000001   210 NEXTTST  EQU   *
000020D4  5850 C000                     00000000   211          L     R5,0(0,R12)         get test address
000020D8  1255                                     212          LTR   R5,R5                have a test?
000020DA  4780 8188                     00002188   213          BZ    ENDTEST                 done?
                                                   214
000020DE                      00000000             215          USING PLOETEST,R5
                                                   216
                                                   217 * save before a test
000020DE  EB0F 8108 0024                00002108   218          STMG  R0,R15,SVTST        Save regs before test
                                                   219
                                                   220 * start a test
000020E4  E300 5004 0015                00000004   221          LGH   R0,TNUM             Save current test number
000020EA  5000 A004                     00004004   222          ST    R0,TESTING
                                                   223
000020EE  58B0 5000                     00000000   224          L     R11,TSUB            get address of test routine
000020F2  05BB                                     225          BALR  R11,R11             do test
                                                   226
                                                   227 * restore after a test
000020F4  EB0F 8108 0004                00002108   228          LMG   R0,R15,SVTST        restore regs after test
                                                   229
000020FA  41C0 C004                     00000004   230          LA    R12,4(0,R12)        next test address
000020FE  47F0 80D4                     000020D4   231          B     NEXTTST
                                                   232
00002108  00000000 00000000                        233 SVTST    DS    16D                 save area



                                                   235 ***********************************************************************
                                                   236 * end of testing; set ending psw
                                                   237 ***********************************************************************
                              00002188  00000001   238 ENDTEST  EQU   *
00002188  5810 A000                     00004000   239          L     R1,FAILED           did a test fail?
0000218C  1211                                     240          LTR   R1,R1
0000218E  4780 8660                     00002660   241          BZ    EOJ                 No, exit
00002192  47F0 8678                     00002678   242          B     FAILTEST            Yes, exit with BAD PSW
