                                                   130 *  Register Usage:
                                                   131 *
                                                   132 *   R0-R4    (work)
                                                   133 *   R5       Testing control table - base current entry
                                                   134 *   R6-R7    (work)
                                                   135 *   R8       First base register
                                                   136 *   R9       Second base register
                                                   137 *   R10-R13  (work)
                                                   138 *   R14      Subroutine call return
                                                   139 *   R15      Secondary Subroutine call return or work
                                                   140 *
                                                   141 ***********************************************************************

00000200                      00000200             143          USING  BEGIN,R8           FIRST Base Register
00000200                      00001200             144          USING  BEGIN+4096,R9      SECOND Base Register

00000200  0580                                     146 BEGIN    BALR  R8,0                Initalize FIRST base register
00000202  0680                                     147          BCTR  R8,0                Initalize FIRST base register
00000204  0680                                     148          BCTR  R8,0                Initalize FIRST base register

00000206  4190 8800                     00000800   150          LA    R9,2048(,R8)        Initalize SECOND base register
0000020A  4190 9800                     00000800   151          LA    R9,2048(,R9)        Initalize SECOND base register
