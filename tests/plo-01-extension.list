                                                   759 *----------------------------------------------------------------------
                                                   760 * PTTABLE: generate table of pointers to individual tests
                                                   761 *----------------------------------------------------------------------
                                                   762
                                                   763          MACRO
                                                   764          PTTABLE
                                                   765          GBLA  &TNUM
                                                   766          LCLA  &CUR
                                                   767 &CUR     SETA  1
                                                   768 .*
                                                   769 TTABLE   DS    0F
                                                   770 .LOOP    ANOP
                                                   771 .*
                                                   772          DC    A(T&CUR)
                                                   773 .*
                                                   774 &CUR     SETA  &CUR+1
                                                   775          AIF   (&CUR LE &TNUM).LOOP
                                                   776 *
                                                   777          DC    A(0)              END OF TABLE
                                                   778          DC    A(0)
                                                   779 .*
                                                   780          MEND
