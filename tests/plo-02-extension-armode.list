                                                   111 ***********************************************************************
                                                   112 *        FCHECK Macro - Is a Facility Bit set?
                                                   113 *
                                                   114 *        If the facility bit is NOT set, an message is issued and
                                                   115 *        the test is skipped.
                                                   116 *
                                                   117 *        Fcheck uses R0, R1 and R2
                                                   118 *
                                                   119 * eg.    FCHECK 134,'vector-packed-decimal'
                                                   120 ***********************************************************************
                                                   121          MACRO
                                                   122          FCHECK &BITNO,&NOTSETMSG
                                                   123 .*                        &BITNO : facility bit number to check
                                                   124 .*                        &NOTSETMSG : 'facility name'
                                                   125          LCLA  &FBBYTE           Facility bit in Byte
                                                   126          LCLA  &FBBIT            Facility bit within Byte
                                                   127
                                                   128          LCLA  &L(8)
                                                   129 &L(1)    SetA  128,64,32,16,8,4,2,1  bit positions within byte
                                                   130
                                                   131 &FBBYTE  SETA  &BITNO/8
                                                   132 &FBBIT   SETA  &L((&BITNO-(&FBBYTE*8))+1)
                                                   133 .*       MNOTE 0,'checking Bit=&BITNO: FBBYTE=&FBBYTE, FBBIT=&FBBIT'
                                                   134
                                                   135          B     X&SYSNDX
                                                   136 *                                      Fcheck data area
                                                   137 *                                      skip messgae
                                                   138 SKT&SYSNDX DC  C'          Skipping tests: '
                                                   139          DC    C&NOTSETMSG
                                                   140          DC    C' facility (bit &BITNO) is not installed.'
                                                   141 SKL&SYSNDX EQU *-SKT&SYSNDX
                                                   142 *                                      facility bits
                                                   143          DS    FD                      gap
                                                   144 FB&SYSNDX DS   4FD
                                                   145          DS    FD                      gap
                                                   146 *
                                                   147 X&SYSNDX EQU *
                                                   148          LA    R0,((X&SYSNDX-FB&SYSNDX)/8)-1
                                                   149          STFLE FB&SYSNDX               get facility bits
                                                   150
                                                   151          XGR   R0,R0
                                                   152          IC    R0,FB&SYSNDX+&FBBYTE    get fbit byte
                                                   153          N     R0,=F'&FBBIT'           is bit set?
                                                   154          BNZ   XC&SYSNDX
                                                   155 *
                                                   156 * facility bit not set, issue message and exit
                                                   157 *
                                                   158          LA    R0,SKL&SYSNDX           message length
                                                   159          LA    R1,SKT&SYSNDX           message address
                                                   160          BAL   R2,MSG
                                                   161
                                                   162          B     EOJ
                                                   163 XC&SYSNDX EQU *
                                                   164          MEND
                                                   165
