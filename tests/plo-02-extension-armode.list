                              00000000  0004DA73  1239 PLOETST  CSECT
                                                  1240          PRINT DATA
                                                  1241 * ---------------------------------------------------------------------
                                                  1242 * NOTE:  Test PLO-Extension functions with ALET operands
                                                  1243 *        - random source created in Pri, Sec and Home spaces
                                                  1244 *
                                                  1245 *        A test is structured as follows:
                                                  1246 *
                                                  1247 *        TSTHDR
                                                  1248 *        TSTCODE
                                                  1249 *
                                                  1250 *        ... code to test the function
                                                  1251 *
                                                  1252 *        TSTDATA                   test data is located here
                                                  1253 *        TSTLBL OPDST              Operand Destination
                                                  1254 *        DC    XL128'0'
                                                  1255 *
                                                  1256 *        TSTLBL OPSRC              Operand Source
                                                  1257 *        DC    XL128'0'
                                                  1258 *
                                                  1259 *        TSTLBL PL                 Parameter List
                                                  1260 *        DC    XL256'00'
                                                  1261 *
                                                  1262 *        TSTLBL FMSG               fail message
                                                  1263 *        DC    C'failed PLO-Extension '
                                                  1264 *        DC    CLxx'.......'
                                                  1265 *
                                                  1266 *        TSTEND
                                                  1267 *
                                                  1268 * ---------------------------------------------------------------------
                                                  1269 *
                                                  1270 *  Register Usage:
                                                  1271 *
                                                  1272 *   R0-R4      (work)
                                                  1273 *   R5       Testing control table - base current entry
                                                  1274 *   R6         (test work) - secondary space
                                                  1275 *   R7         (test work) - home space
                                                  1276 *   R8       First base register
                                                  1277 *   R9       Second base register
                                                  1278 *   R10      Third base register
                                                  1279 *   R11      Return from test
                                                  1280 *   R12        (test work) - secondary space
                                                  1281 *   R13        (test work) - home space
                                                  1282 *   R14      Subroutine call return
                                                  1283 *   R15      Secondary Subroutine call return
                                                  1284 *            - test: used as PLO R3 (alet register)
                                                  1285 *
                                                  1286 * ---------------------------------------------------------------------
