                                                    61 *
                                                    62 *                    Memory Map - REAL STORAGE
                                                    63 *
                                                    64
                                                    65 *                 General Layout
                                                    66 *
                                                    67 *                 Description
                                                    68 *                 -----------------------------------------------------
                                                    69 * 0    - 48K    - Absolute page 0 and 1, program code
                                                    70 * 48K  - 128K   - segment and page tables
                                                    71 * 128K - 384K   - Pages for Primary virtual space       at vaddr 20000
                                                    72 * 384K - 640K   - Pages for Secondary virtual space     at vaddr 20000
                                                    73 * 640K - 896K   - Pages for Home virtual space          at vaddr 20000
                                                    74 *
                                                    75 *
                                                    76 *                    Memory Map - REAL STORAGE
                                                    77 *                    =========================
                                                    78 *         Hex
                                                    79 * RAddr   Len     Description
                                                    80 * -----   ----    -----------------------------------------------------
                                                    81 *     0   2000  - Absolute page 0 and 1
                                                    82 *  2000   A000  - Program code
                                                    83 *  C000   1000  - Segment table, primary space
                                                    84 *  D000   1000  - Segment table, secondary space
                                                    85 *  E000   1000  - Segment table, home space
                                                    86 * 10000   4000  - Page tables, primary space
                                                    87 * 14000   4000  - Page tables, secondary space
                                                    88 * 18000   4000  - Page tables, home space
                                                    89 * 19000   1000  - Primary ASTE, DUCT, DU-AL, ALE blocks
                                                    90 * 1A000   1000  - Home ASTE block
                                                    91 * 1B000   5000  - unused; available
                                                    92 * 20000  40000  - Pages backing Primary virtual space at vaddr 20000
                                                    93 * 60000  40000  - Pages backing Secondary virtual space at vaddr 20000
                                                    94 * A0000  40000  - Pages backing Home virtual space at vaddr 20000
                                                    95 *
                                                    96 *
                                                    97 *                    Memory Map - VIRTUAL STORAGE
                                                    98 *                    ============================
                                                    99 *         Hex
                                                   100 * VAddr   Len   Raddr  Key   Description
                                                   101 * -----   ----   ----  ---   ---------------------------------------
                                                   102 * 0000   C0000  00000  00 - Common V=R storage (all address spaces)
                                                   103 * 20000  40000  20000  00 - Primary space storage
                                                   104 * 20000  40000  60000  00 - Secondary space storage
                                                   105 * 20000  40000  A0000  00 - Home space storage
                                                   106 *
                                                   107 *
