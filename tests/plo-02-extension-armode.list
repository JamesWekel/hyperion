                                                  1210 *----------------------------------------------------------------------
                                                  1211 * PTTABLE: table of pointers to each test
                                                  1212 *----------------------------------------------------------------------
                                                  1213 *
                                                  1214 *        generate table of pointers to individual tests
                                                  1215 *
                                                  1216          MACRO
                                                  1217          PTTABLE
                                                  1218          GBLA  &TNUM
                                                  1219          LCLA  &CUR
                                                  1220 &CUR     SETA  1
                                                  1221 .*
                                                  1222 TTABLE   DS    0F
                                                  1223 .LOOP    ANOP
                                                  1224 .*
                                                  1225          DC    A(T&CUR)
                                                  1226 .*
                                                  1227 &CUR     SETA  &CUR+1
                                                  1228          AIF   (&CUR LE &TNUM).LOOP
                                                  1229 *
                                                  1230          DC    A(0)                END OF TABLE
                                                  1231          DC    A(0)
                                                  1232 .*
                                                  1233          MEND
